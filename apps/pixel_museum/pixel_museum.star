# --- END ARTWORKS ---

W = 64
H = 32
DELAY_MS = 50  # 20 fps keeps transitions smooth
MAX_FRAMES = 300  # Tidbyt shows an app for at most 15s: 300 * 50ms
TRANSITION_FRAMES = 16  # 0.8s per transition
ROTATE_EVERY_SECONDS = 15 * 60  # matches the auto-push interval: next set each refresh

TRANSITIONS = ["fade", "slide", "wipe", "dissolve"]
DEFAULT_TRANSITION = "random"
DEFAULT_SECONDS = "4"

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def ease(t):
    """Smooth in-out curve (0..1 -> 0..1)."""
    if t < 0.5:
        return 4 * t * t * t
    u = -2 * t + 2
    return 1 - u * u * u / 2

HEX = "0123456789abcdef"

def hex2(v):
    """0..255 -> two hex digits (Starlark's % has no zero-padding)."""
    return HEX[v // 16] + HEX[v % 16]

def lcg(seed):
    return (seed * 1103515245 + 12345) % 2147483648

def shuffled(n, seed):
    order = list(range(n))
    s = seed
    for i in range(n - 1, 0, -1):
        s = lcg(s)
        j = s % (i + 1)
        order[i], order[j] = order[j], order[i]
    return order

def picture(art):
    return render.Image(src = art["png"], width = W, height = H)

def crop(img, x, y, w, h):
    """Show only the (x, y, w, h) region of a full-screen widget, in place."""
    return render.Padding(
        pad = (x, y, 0, 0),
        child = render.Box(
            width = w,
            height = h,
            child = render.Padding(pad = (-x, -y, -(W - x - w), -(H - y - h)), child = img),
        ),
    )

def hold(widget, frames):
    return render.Animation(children = [widget] * frames)

# ---------------------------------------------------------------------------
# Transitions: each returns a list of TRANSITION_FRAMES frames going a -> b
# ---------------------------------------------------------------------------

def fade_frames(a, b, n):
    frames = []
    half = n // 2
    for i in range(n):
        if i < half:
            img, alpha = a, (i + 1) / half  # fade a out to black
        else:
            img, alpha = b, 1 - (i - half + 1) / (n - half)  # fade b in from black
        level = int(ease(alpha) * 255)
        frames.append(render.Stack(children = [
            img,
            render.Box(width = W, height = H, color = "#000000" + hex2(level)),
        ]))
    return frames

def slide_frames(a, b, n):
    frames = []
    for i in range(n):
        d = int(ease((i + 1) / n) * W)
        frames.append(render.Stack(children = [
            render.Padding(pad = (-d, 0, 0, 0), child = a),
            render.Padding(pad = (W - d, 0, 0, 0), child = b),
        ]))
    return frames

def wipe_frames(a, b, n):
    frames = []
    for i in range(n):
        x = int(ease((i + 1) / n) * W)
        layers = [a]
        if x > 0:
            layers.append(crop(b, 0, 0, x, H))
        if x < W:
            # bright "curtain" edge with a soft trailing glow
            layers.append(render.Padding(pad = (x, 0, 0, 0), child = render.Box(width = 1, height = H, color = "#fff6d8")))
            if x > 0:
                layers.append(render.Padding(pad = (x - 1, 0, 0, 0), child = render.Box(width = 1, height = H, color = "#fff6d860")))
        frames.append(render.Stack(children = layers))
    return frames

def dissolve_frames(a, b, n, seed):
    bs = 4  # block size
    cols, rows = W // bs, H // bs
    order = shuffled(cols * rows, seed)
    blocks = []
    for k in order:
        bx, by = (k % cols) * bs, (k // cols) * bs
        blocks.append(crop(b, bx, by, bs, bs))
    frames = []
    for i in range(n):
        shown = (len(blocks) * (i + 1)) // n
        if shown >= len(blocks):
            frames.append(b)
        else:
            frames.append(render.Stack(children = [a] + blocks[:shown]))
    return frames

def transition_frames(kind, a, b, seed):
    n = TRANSITION_FRAMES
    if kind == "slide":
        return slide_frames(a, b, n)
    if kind == "wipe":
        return wipe_frames(a, b, n)
    if kind == "dissolve":
        return dissolve_frames(a, b, n, seed)
    return fade_frames(a, b, n)

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def message(text):
    return render.Root(child = render.Box(child = render.WrappedText(text, font = "tom-thumb", color = "#c8b88a", align = "center", width = 62)))

def main(config):
    enabled = [a for a in ARTWORKS if config.bool("show_" + a["id"], True)]
    if not enabled:
        return message("Pixel Museum: turn on at least one artwork")

    seconds = int(config.str("seconds", DEFAULT_SECONDS))
    hold_frames = seconds * 1000 // DELAY_MS
    if hold_frames >= MAX_FRAMES:
        per_cycle = 1
        hold_frames = MAX_FRAMES
    else:
        per_cycle = max(1, (MAX_FRAMES + TRANSITION_FRAMES) // (hold_frames + TRANSITION_FRAMES))
    per_cycle = min(per_cycle, len(enabled))

    # Walk through the collection: every refresh shows the next few artworks.
    now = time.now().unix
    slot = now // ROTATE_EVERY_SECONDS
    if config.str("start"):  # preview helper: ?start=3 begins at the 4th artwork
        slot = int(config.str("start"))
        start = slot % len(enabled)
    else:
        start = (slot * per_cycle) % len(enabled)
    chosen = [enabled[(start + i) % len(enabled)] for i in range(per_cycle)]

    choice = config.str("transition", DEFAULT_TRANSITION)
    seed = lcg(slot + 7)
    pictures = [picture(a) for a in chosen]

    children = [hold(pictures[0], hold_frames)]
    for i in range(1, len(pictures)):
        seed = lcg(seed)
        kind = TRANSITIONS[seed % len(TRANSITIONS)] if choice == "random" else choice
        children.append(render.Animation(children = transition_frames(kind, pictures[i - 1], pictures[i], seed)))
        children.append(hold(pictures[i], hold_frames))

    return render.Root(
        delay = DELAY_MS,
        show_full_animation = True,
        child = render.Sequence(children = children),
    )

def get_schema():
    fields = [
        schema.Dropdown(
            id = "transition",
            name = "Transition",
            desc = "How one artwork changes to the next.",
            icon = "wandMagicSparkles",
            default = DEFAULT_TRANSITION,
            options = [
                schema.Option(display = "Random", value = "random"),
                schema.Option(display = "Fade through black", value = "fade"),
                schema.Option(display = "Slide", value = "slide"),
                schema.Option(display = "Wipe / curtain", value = "wipe"),
                schema.Option(display = "Pixel dissolve", value = "dissolve"),
            ],
        ),
        schema.Dropdown(
            id = "seconds",
            name = "Time per artwork",
            desc = "Longer times show fewer artworks per rotation.",
            icon = "clock",
            default = DEFAULT_SECONDS,
            options = [
                schema.Option(display = "3 seconds (4 artworks)", value = "3"),
                schema.Option(display = "4 seconds (3 artworks)", value = "4"),
                schema.Option(display = "6 seconds (2 artworks)", value = "6"),
                schema.Option(display = "15 seconds (1 artwork)", value = "15"),
            ],
        ),
    ]
    for a in ARTWORKS:
        fields.append(schema.Toggle(
            id = "show_" + a["id"],
            name = a["title"],
            desc = "%s, %s" % (a["artist"], a["year"]),
            icon = "palette",
            default = True,
        ))
    return schema.Schema(version = "1", fields = fields)
